# dfsc-StepAudio MCP 服务配置示例
# 两种用法：
# A. 开发/直连：把本文件内容 export 为环境变量后运行 node src/index.js
# B. DFSC 市场安装：Key 放在插件目录外的私密 env 文件里，用 scripts/configure.mjs 登记
#    （mcpServers.env 只有占位符，见 step.plugin.json 与 README「独立模式」）
# 切勿把真实 key 提交进仓库或放入插件目录。

# ---- A. 环境变量直填 ----

# 后端模式：stepplan = Step Plan 登录态额度；openapi = 开放平台 / 任意 OpenAI 兼容服务
# STEPAUDIO_MODE=stepplan

# openapi 模式下自定义 base URL（默认 https://api.stepfun.com/v1）
# STEPAUDIO_BASE_URL=https://api.stepfun.com/v1

# API Key（按 STEP_API_KEY -> STEPFUN_API_KEY -> DFSC_STEP_PLAN_API_KEY 顺序探测；
# 值等于 stepaudio-managed-provider-context 时视为未配置，转读私密配置）
# 注意：市场清单 step.plugin.json 的占位符写在 STEPFUN_API_KEY 上——那是宿主
# 自动注入登录凭据的变量，占位符必须占住它才能阻止真实凭据进入 MCP 子进程。
# STEP_API_KEY=

# 默认模型：stepaudio-2.5-tts（也支持 stepaudio-3-tts / step-tts-2 / step-tts-mini）
# STEPAUDIO_MODEL=stepaudio-2.5-tts

# 音频输出目录（默认 <插件目录>/output）
# STEPAUDIO_OUTPUT_DIR=

# ---- B. 私密配置位置（可选覆盖）----
# STEPAUDIO_CONFIG_PATH=D:/Private/stepaudio/config.json
# STEPAUDIO_PROFILE_DIR=D:/Private/stepaudio
