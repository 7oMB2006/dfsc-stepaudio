# Copy outside the installed plugin directory, then edit privately.
# Only independent mode reads credentials from this file.
# Follow DFSC mode (host bridge) ignores the provider, key, endpoint and model settings below.
# 使用方法：
#   1. 把本文件复制到插件目录以外的私密位置（例如 D:/Private/stepaudio/provider.env）
#   2. 填入你的 API Key，并按需选择 base URL 与模型
#   3. node scripts/configure.mjs --profile <目录> --mode independent --env-file <该文件绝对路径>
# 切勿把填好 Key 的文件提交进仓库或放入插件目录。

# API Key（必填；STEP_API_KEY 或 STEPFUN_API_KEY 任一即可）
STEP_API_KEY=REPLACE_WITH_YOUR_KEY

# 二选一：Step Plan 登录态额度 或 开放平台 / 任意 OpenAI 兼容网关
# STEPAUDIO_MODE=stepplan
# STEPAUDIO_BASE_URL=https://api.stepfun.com/step_plan/v1
# STEPAUDIO_BASE_URL=https://api.stepfun.com/v1

# 可选：默认模型与输出目录
# STEPAUDIO_MODEL=stepaudio-2.5-tts
# STEPAUDIO_OUTPUT_DIR=D:/StepFun/dfsc-StepAudio/output
