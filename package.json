{
  "name": "dfsc-stepaudio",
  "version": "0.2.0",
  "private": true,
  "description": "DFSC 插件：阶跃 StepAudio TTS 的 MCP 服务（语音合成 / 音色列表 / 音色复刻）。开发用官方 MCP SDK，分发为自包含单文件 dist/index.js，用户无需包管理器依赖",
  "type": "module",
  "bin": {
    "dfsc-stepaudio": "dist/index.js"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node src/index.js",
    "test": "node --test \"test/*.test.js\"",
    "pretest": "npm run build",
    "smoke": "node scripts/smoke.mjs",
    "configure": "node scripts/configure.mjs",
    "make-icon": "node scripts/make-icon.mjs",
    "docs:voices": "node scripts/build-voices-doc.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "esbuild": "0.28.2"
  }
}
